{
  "name": "servora-notification",
  "version": "0.1.0",
  "description": "Standalone notification delivery service for Servora (email + SMS).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/node": "^26.4.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "pino": "^10.3.1",
    "resend": "^6.25.0",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
